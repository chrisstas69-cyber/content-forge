# Supabase authentication, database, and storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe subscriptions
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# 32-byte encryption key for credentials stored in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Protects scheduled/background endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Database
DATABASE_URL=

# Reachable base URL of the separately deployed media worker.
# Optional: readiness can probe /health. The Mac worker also reports a private heartbeat.
CONTENT_WORKER_URL=

# Optional preview-only bridge for a local worker (never the service role key).
# Generate the token locally, set it on the test branch's Preview environment,
# and keep the same token in the local worker's gitignored environment file.
CONTENT_WORKER_TOKEN=
# Local worker only: the matching Preview deployment URL.
CONTENT_WORKER_APP_URL=

# Optional OpenRouter, Deepgram, and Zernio keys are entered in Studio Settings.
# They are encrypted per workspace. No provider key is required for manual drafts/exports.
# Password-free test access must stay on the dedicated Preview branch.
TEST_MODE_ENABLED=false
TEST_MODE_USER_EMAIL=

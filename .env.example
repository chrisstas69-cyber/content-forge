# Supabase authentication, database, and storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe subscriptions
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# 32-byte encryption key for credentials stored in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Protects scheduled/background endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Database
DATABASE_URL=

# Reachable base URL of the separately deployed media worker.
# Dashboard readiness probes its /health endpoint; uploads need a running worker.
CONTENT_WORKER_URL=

# Optional preview-only bridge for a local worker (never the service role key).
# Generate the token locally, set it on the test branch's Preview environment,
# and keep the same token in the local worker's gitignored environment file.
CONTENT_WORKER_TOKEN=
# Local worker only: the matching Preview deployment URL.
CONTENT_WORKER_APP_URL=

# Optional provider credentials can be entered through the protected API Keys
# screen. Prefer the screen over adding credentials to this file.
